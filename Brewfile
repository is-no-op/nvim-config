# Command-line tools for this Neovim setup (macOS). Installed by setup.sh via `brew bundle`.

# Apps go to ~/Applications, so installing them doesn't need an admin password.
cask_args appdir: "~/Applications"

brew "neovim"   # stable release
brew "ripgrep"  # project-wide search (<leader>/), file finder fallback
brew "fd"       # fast file finder; required by the Python venv picker (<leader>cv)
brew "lazygit"  # git UI (<leader>gg)
brew "node"     # npm (Claude chat adapter) and Node-based language servers (pyright, yamlls, jsonls)
brew "go"       # Go toolchain for gopls and Go tools installed by Mason

cask "ghostty"                        # terminal with 24-bit color (Terminal.app works too on macOS 26+)
cask "font-jetbrains-mono-nerd-font"  # icons in the tree/statusline; select it in Terminal.app if you use that
